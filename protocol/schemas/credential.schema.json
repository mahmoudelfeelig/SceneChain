{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenechain.local/schemas/credential-v1.json",
  "title": "SceneChain credential input version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "policyVersion", "stages"],
  "properties": {
    "protocolVersion": { "const": 1 },
    "policyVersion": { "const": 1 },
    "stages": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sceneId", "cellId", "actionId"],
        "properties": {
          "sceneId": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
          "cellId": { "type": "integer", "minimum": 0, "maximum": 383 },
          "actionId": { "type": "integer", "minimum": 0, "maximum": 3 }
        }
      }
    }
  }
}
