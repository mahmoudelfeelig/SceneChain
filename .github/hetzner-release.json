{
  "version": 1,
  "id": "scenechain",
  "source": {
    "repository": "mahmoudelfeelig/SceneChain",
    "default_branch": "main",
    "required_workflows": ["SceneChain CI"]
  },
  "registry": {
    "host": "registry.elfeel.me",
    "image_namespace": "apps/scenechain",
    "release_repository": "releases/scenechain"
  },
  "release": {
    "strategy": "source-build",
    "components": [
      {
        "name": "backend",
        "context": "backend",
        "dockerfile": "backend/Dockerfile"
      },
      {
        "name": "frontend",
        "context": "frontend",
        "dockerfile": "frontend/Dockerfile"
      }
    ]
  }
}
